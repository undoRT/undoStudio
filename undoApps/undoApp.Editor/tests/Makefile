# Compiles the sources the ST editor tests share, into one archive.
#
# The test runner drives this rather than a shell loop, for two reasons that the
# loop could not give. The thirty-odd shared sources compile in parallel, which is
# most of what makes the suite fast: the runner used to hand the same thirty
# thousand lines to g++ once per test, seventeen times over. And the generated
# dependency files make a header edit rebuild whatever included it, so a test
# cannot go on passing against a previous build of a header that has changed.
#
# Written as a file rather than generated by the runner, so that the rules are
# readable and the escaping is not fought in shell: a backslash-space is not a
# line continuation to make, and getting that wrong fails in a way whose message
# points at a source file that is perfectly fine.
#
# The runner sets ROOT and OUT; both default to the layout the runner uses.

ROOT ?= $(abspath ../..)
OUT ?= $(TMPDIR)/undoStudio-tests

CXX      := g++
CXXFLAGS := -std=c++17 -O1
INC := -I $(ROOT)/undoApps/undoApp.Editor/include \
       -I $(ROOT)/third_party/st2cpp/include \
       -I $(ROOT)/third_party/ImGuiColorTextEdit \
       -I $(ROOT)/third_party/imgui \
       -I $(ROOT)/third_party/nlohmann_json/single_include \
       -I $(ROOT)/include

PLUGIN_SRC := \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppSTSemantic.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppSTSnippet.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppST.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppEditor.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppJSON.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppText.cpp \
  $(ROOT)/undoApps/undoApp.Editor/src/undoAppCpp.cpp \
  $(ROOT)/third_party/ImGuiColorTextEdit/TextEditor.cpp

# The st2cpp sources, minus the CLI: the tests use the library, not the tool.
ST2CPP_SRC := $(shell find $(ROOT)/third_party/st2cpp/src -name '*.cpp' ! -path '*cli*')

SHARED_SRC := $(PLUGIN_SRC) $(ST2CPP_SRC)
# An object keeps the source's path below ROOT, so two sources that share a
# basename in different directories do not overwrite one another.
OBJS := $(patsubst $(ROOT)/%.cpp,$(OUT)/obj/%.o,$(SHARED_SRC))

ARCHIVE := $(OUT)/libplugintest.a

.PHONY: all directories
all: $(ARCHIVE)

$(ARCHIVE): $(OBJS)
	@mkdir -p $(dir $@)
	ar rcs $@ $^

$(OUT)/obj/%.o: $(ROOT)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INC) -MMD -MP -c $< -o $@

-include $(OBJS:.o=.d)
