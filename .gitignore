# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
# The editor suite's own Makefile is not one of those: it is hand-written, and it
# is what compiles the sources the tests share into a single archive. Ignoring it
# is not a build that stops working, it is a build that keeps working on the
# machine that wrote it, because the file is still on disk there and missing from
# every clone — so the suite passes locally and fails in CI with "Makefile: No
# such file or directory" and nothing else.
!undoApps/undoApp.Editor/tests/Makefile
install_manifest.txt
compile_commands.json

# CMake generated files that the top-level configuration writes into the source
# tree, because the project is configured in-source: CPack, the Doxygen input
# and the CTest driver are all regenerated on every configure run.
CPackConfig.cmake
CPackSourceConfig.cmake
CTestTestfile.cmake
CMakeDoxyfile.in
CMakeDoxygenDefaults.cmake
progress.marks

# The application binary itself
/undoStudio

# ImGui state written at runtime rather than configured by hand: imgui.ini is
# Dear ImGui's own window/menu state, undoStudio_layout.ini is the dock layout
# the user has arranged and should be able to throw away and rebuild.
#
# The one under resources/ is not state: it is the layout the project ships, and a
# fresh install is opened from it.
imgui.ini
undoStudio_layout.ini
!resources/undoStudio_layout.ini

# The undoApps' own preferences, each next to the layout they belong with, and
# the core's: the window size and the projects opened recently.
undoApp.Terminal.ini
undoApp.Editor.ini
undoStudio.ini

# st2cpp is built out-of-source under build/; a stray in-source configure of the
# CLI leaves this behind.
/st2cpp/

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Editor and IDE state, which describes how one machine happens to be set up
.vscode/
.idea/
*.code-workspace
